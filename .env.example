# Settings for docker-compose.yml (README: Deployment with Docker).
# Copy to .env (git ignores it) and fill in the values marked "required".

# Required: the Django secret key, e.g. from
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Required: the host name(s) Plina is reached under, comma-separated.
ALLOWED_HOSTS=plina.example.com
# The HTTPS origin(s) of those host names (for the Django admin's forms).
CSRF_TRUSTED_ORIGINS=https://plina.example.com
# Cookies (Django admin) only over HTTPS. False only to try the admin over
# plain HTTP, e.g. at http://<server>:8080 before TLS is set up.
SECURE_COOKIES=True

# Required: the database password, e.g. from  openssl rand -hex 32
DB_PASSWORD=
DB_NAME=plina
DB_USER=plina

# Where nginx listens for the reverse proxy (TLS).
PLINA_HTTP_BIND=127.0.0.1
PLINA_HTTP_PORT=8080
# The htpasswd file with the users who may log in.
PLINA_HTPASSWD=./htpasswd
